NODE_ENV=development
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8787
GATEWAY_AUTH_TOKEN=change-me
# Production WSS certificate/key (or terminate TLS at a trusted reverse proxy)
# GATEWAY_TLS_CERT_PATH=./certs/fullchain.pem
# GATEWAY_TLS_KEY_PATH=./certs/privkey.pem
GATEWAY_STORE_PATH=./data/gateway-store.json
GATEWAY_STORE_DRIVER=file
# Shared 32-byte Base64 key for encrypted WeCom runtime snapshots.
# WECOM_RUNTIME_CONFIG_KEY=replace-with-a-generated-32-byte-base64-key
WECOM_RUNTIME_CONFIG_STORE_PATH=./data/wecom-runtime-configs.json
WECOM_SYNC_STATE_STORE_PATH=./data/wecom-sync-states.json
# MySQL Store: use a dedicated database, never Rag's rag_customer_service database.
# GATEWAY_DB_HOST=127.0.0.1
# GATEWAY_DB_PORT=3306
# GATEWAY_DB_NAME=cloud_channel_gateway
# GATEWAY_DB_USER=cloud_gateway
# GATEWAY_DB_PASSWORD=replace-me
# GATEWAY_DB_SSL=false
# GATEWAY_DB_POOL_MAX=10
# GATEWAY_DB_LEASE_MS=60000
GATEWAY_MOCK_INBOUND_ENABLED=true
# Optional separate development token; defaults to GATEWAY_AUTH_TOKEN.
# GATEWAY_MOCK_INBOUND_TOKEN=replace-with-a-local-mock-token
GATEWAY_AUTH_TIMEOUT_MS=5000
GATEWAY_HEARTBEAT_MS=15000
GATEWAY_ACK_TIMEOUT_MS=10000
GATEWAY_RETRY_BASE_MS=500
GATEWAY_RETRY_MAX_MS=30000
GATEWAY_MAX_RETRIES=5
