{
  "name": "@rag/commerce-protocol",
  "version": "0.2.0",
  "private": true,
  "description": "Vendor-neutral external commerce order protocol",
  "license": "UNLICENSED",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
