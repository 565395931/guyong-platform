{
  "name": "platform-web",
  "version": "1.0.1",
  "private": true,
  "description": "客户服务聚合工作台桌面端",
  "author": "The Lonely Brave",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --port 3003",
    "build": "vite build",
    "preview": "vite preview --port 3003",
    "desktop:dev": "node scripts/desktop-dev.mjs",
    "desktop:build": "npm run build -- --base ./ && electron-builder --dir",
    "desktop:dist": "npm run build -- --base ./ && electron-builder",
    "test": "node scripts/run-tests.mjs",
    "test:catalog": "node --test src/modules/catalog/catalogForm.test.js",
    "test:platform-connections": "node --test src/modules/platformConnections/connectionForm.test.js",
    "test:channel-events": "node --test src/modules/channels/channelEvents.test.js",
    "test:channel-navigation": "node --test src/modules/navigation/channelNavigation.test.js src/modules/navigation/channelChrome.test.js src/modules/conversations/channelScope.test.js",
    "test:message-review": "node --test src/modules/messageReviews/reviewQueue.test.js",
    "test:ai-config": "node --test src/modules/aiConfig/aiConfigForm.test.js"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.6.8",
    "dayjs": "^1.11.10",
    "echarts": "^5.5.0",
    "element-plus": "^2.14.3",
    "pinia": "^2.1.7",
    "socket.io-client": "^4.7.5",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "electron": "^37.10.3",
    "electron-builder": "^26.15.3",
    "sass": "^1.75.0",
    "vite": "^5.4.21"
  },
  "build": {
    "appId": "cn.thelonelybrave.rag.workbench",
    "productName": "客户服务聚合工作台",
    "artifactName": "RagWorkbench-${version}-${os}-${arch}.${ext}",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*.cjs", "!electron/**/*.test.cjs", "!node_modules/**/*", "package.json"],
    "asar": true,
    "compression": "maximum",
    "electronDownload": {
      "mirror": "https://cdn.npmmirror.com/binaries/electron/"
    },
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "客户服务聚合工作台",
      "deleteAppDataOnUninstall": false
    }
  }
}
