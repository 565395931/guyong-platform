{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schemas/external-order-projection-command.v2.schema.json",
  "title": "External Order Projection Command v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "commandId",
    "eventInboxId",
    "schemaVersion",
    "channel",
    "accountId",
    "externalOrderId",
    "externalVersion",
    "occurredAt",
    "currency",
    "customer",
    "lines",
    "shippingLines",
    "amounts",
    "normalizedStatus",
    "rawPayloadRef"
  ],
  "properties": {
    "commandId": { "$ref": "#/$defs/nonEmptyString" },
    "eventInboxId": {
      "oneOf": [
        { "$ref": "#/$defs/nonEmptyString" },
        { "type": "integer", "minimum": 0 }
      ]
    },
    "schemaVersion": { "const": 2 },
    "channel": { "$ref": "#/$defs/nonEmptyString" },
    "accountId": { "type": "integer", "minimum": 0 },
    "externalOrderId": { "$ref": "#/$defs/nonEmptyString" },
    "externalVersion": { "$ref": "#/$defs/nonEmptyString" },
    "occurredAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$"
    },
    "currency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "exponent"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "exponent": { "type": "integer", "minimum": 0, "maximum": 6 }
      }
    },
    "customer": { "$ref": "#/$defs/customer" },
    "shippingAddress": { "$ref": "#/$defs/shippingAddress" },
    "lines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/orderLine" }
    },
    "shippingLines": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/shippingLine" }
    },
    "amounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["itemGross", "itemDiscount", "shippingGross", "shippingDiscount", "tax", "total"],
      "properties": {
        "itemGross": { "$ref": "#/$defs/amount" },
        "itemDiscount": { "$ref": "#/$defs/amount" },
        "shippingGross": { "$ref": "#/$defs/amount" },
        "shippingDiscount": { "$ref": "#/$defs/amount" },
        "tax": { "$ref": "#/$defs/amount" },
        "total": { "$ref": "#/$defs/amount" }
      }
    },
    "normalizedStatus": {
      "enum": ["created", "paid", "ready_to_ship", "shipped", "delivered", "cancelled", "after_sales"]
    },
    "rawPayloadRef": { "$ref": "#/$defs/nonEmptyString" }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "maxLength": 512, "pattern": ".*\\S.*" },
    "amount": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    },
    "customer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "externalCustomerId": { "$ref": "#/$defs/nonEmptyString" },
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "email": { "$ref": "#/$defs/nonEmptyString" },
        "phone": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "shippingAddress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["countryCode", "line1"],
      "properties": {
        "recipientName": { "$ref": "#/$defs/nonEmptyString" },
        "phone": { "$ref": "#/$defs/nonEmptyString" },
        "countryCode": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "province": { "$ref": "#/$defs/nonEmptyString" },
        "city": { "$ref": "#/$defs/nonEmptyString" },
        "postalCode": { "$ref": "#/$defs/nonEmptyString" },
        "line1": { "$ref": "#/$defs/nonEmptyString" },
        "line2": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "discount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "amount", "funding"],
      "properties": {
        "code": { "$ref": "#/$defs/nonEmptyString" },
        "description": { "$ref": "#/$defs/nonEmptyString" },
        "amount": { "$ref": "#/$defs/amount" },
        "funding": { "enum": ["platform", "seller", "shared", "unknown"] }
      }
    },
    "tax": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "rate", "amount", "includedInSourcePrice"],
      "properties": {
        "code": { "$ref": "#/$defs/nonEmptyString" },
        "rate": { "$ref": "#/$defs/amount" },
        "amount": { "$ref": "#/$defs/amount" },
        "includedInSourcePrice": { "type": "boolean" }
      }
    },
    "orderLine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "externalLineId",
        "sku",
        "quantity",
        "unitAmount",
        "grossAmount",
        "discounts",
        "taxes",
        "totalAmount"
      ],
      "properties": {
        "externalLineId": { "$ref": "#/$defs/nonEmptyString" },
        "sku": { "$ref": "#/$defs/nonEmptyString" },
        "quantity": { "type": "integer", "minimum": 1 },
        "unitAmount": { "$ref": "#/$defs/amount" },
        "grossAmount": { "$ref": "#/$defs/amount" },
        "discounts": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/discount" } },
        "taxes": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/tax" } },
        "totalAmount": { "$ref": "#/$defs/amount" }
      }
    },
    "shippingLine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "externalShippingLineId",
        "methodCode",
        "name",
        "grossAmount",
        "discounts",
        "taxes",
        "totalAmount"
      ],
      "properties": {
        "externalShippingLineId": { "$ref": "#/$defs/nonEmptyString" },
        "methodCode": { "$ref": "#/$defs/nonEmptyString" },
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "grossAmount": { "$ref": "#/$defs/amount" },
        "discounts": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/discount" } },
        "taxes": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/tax" } },
        "totalAmount": { "$ref": "#/$defs/amount" }
      }
    }
  }
}
