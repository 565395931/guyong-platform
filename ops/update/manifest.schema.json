{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://updates.example.invalid/schemas/guyong-update-manifest-v1.json",
  "title": "Guyong Platform Update Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "product", "channel", "version", "publishedAt", "package", "signature"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "product": { "const": "guyong-platform" },
    "channel": { "enum": ["test", "stable"] },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "minimumUpdaterVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "publishedAt": { "type": "string", "format": "date-time" },
    "notes": { "type": "string", "maxLength": 4000 },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "size", "sha256"],
      "properties": {
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "size": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "keyId", "value"],
      "properties": {
        "algorithm": { "const": "ed25519" },
        "keyId": { "type": "string", "minLength": 1, "maxLength": 80 },
        "value": { "type": "string", "minLength": 80, "maxLength": 120 }
      }
    }
  }
}
