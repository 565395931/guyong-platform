{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schemas/external-order-projection-command.schema.json",
  "title": "External Order Projection Command",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "commandId",
    "eventInboxId",
    "schemaVersion",
    "channel",
    "accountId",
    "externalOrderId",
    "externalVersion",
    "occurredAt",
    "currency",
    "customer",
    "lines",
    "amounts",
    "normalizedStatus",
    "rawPayloadRef"
  ],
  "properties": {
    "commandId": { "$ref": "#/$defs/nonEmptyString" },
    "eventInboxId": {
      "oneOf": [
        { "$ref": "#/$defs/nonEmptyString" },
        { "type": "integer", "minimum": 0 }
      ]
    },
    "schemaVersion": { "const": 1 },
    "channel": { "$ref": "#/$defs/nonEmptyString" },
    "accountId": { "type": "integer", "minimum": 0 },
    "externalOrderId": { "$ref": "#/$defs/nonEmptyString" },
    "externalVersion": { "$ref": "#/$defs/nonEmptyString" },
    "occurredAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$"
    },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "customer": { "type": "object" },
    "shippingAddress": { "type": "object" },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["externalLineId", "sku", "quantity", "unitAmount", "totalAmount"],
        "properties": {
          "externalLineId": { "$ref": "#/$defs/nonEmptyString" },
          "sku": { "$ref": "#/$defs/nonEmptyString" },
          "quantity": { "type": "integer", "minimum": 1 },
          "unitAmount": { "$ref": "#/$defs/decimal" },
          "totalAmount": { "$ref": "#/$defs/decimal" }
        }
      }
    },
    "amounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goods", "discount", "shipping", "tax", "total"],
      "properties": {
        "goods": { "$ref": "#/$defs/decimal" },
        "discount": { "$ref": "#/$defs/decimal" },
        "shipping": { "$ref": "#/$defs/decimal" },
        "tax": { "$ref": "#/$defs/decimal" },
        "total": { "$ref": "#/$defs/decimal" }
      }
    },
    "normalizedStatus": {
      "enum": ["created", "paid", "ready_to_ship", "shipped", "delivered", "cancelled", "after_sales"]
    },
    "rawPayloadRef": { "$ref": "#/$defs/nonEmptyString" }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "pattern": ".*\\S.*" },
    "decimal": { "type": "string", "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$" }
  }
}
