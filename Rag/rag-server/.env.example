# Deployment template only. Fill required values locally; never distribute .env.
# See docker/README.md for Docker environment variables and matching WAHA keys.
PORT=3001
SERVER_HOST=http://localhost:3001

# MySQL. Production database password must contain at least 16 characters.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=rag_customer_service
DB_USER=root
DB_PASSWORD=
# Optional: set only when deliberately creating the first administrator.
ADMIN_SEED_PASSWORD=
# Base64-encoded 32-byte key for platform credentials.
PLATFORM_CREDENTIAL_KEY=

# Keep projection disabled until the downstream service passes its security gate.
COMMERCE_PROJECTION_ENABLED=false
COMMERCE_PROJECTION_ENDPOINT=https://commerce.internal.example/internal/v1/order-projections
COMMERCE_PROJECTION_KEY_ID=rag-worker
COMMERCE_PROJECTION_SHARED_SECRET=
COMMERCE_PROJECTION_BATCH_SIZE=25
COMMERCE_PROJECTION_INTERVAL_MS=5000
COMMERCE_PROJECTION_MAX_ATTEMPTS=5
COMMERCE_PROJECTION_RETRY_BASE_MS=1000
COMMERCE_PROJECTION_RETRY_MAX_MS=300000
COMMERCE_PROJECTION_LEASE_TIMEOUT_MS=300000
COMMERCE_PROJECTION_HTTP_TIMEOUT_MS=10000

# Required: generate a dedicated random JWT secret.
JWT_SECRET=
# CORS_ALLOWED_ORIGINS=https://admin.example.com,https://platform.example.com

# AI/RAG provider. Obtain these values from your own provider account.
DASHSCOPE_API_KEY=
WORKSPACE_ID=ws-your-workspace-id
CATEGORY_ID=default
INDEX_ID=your-index-id
DASHSCOPE_MODEL=qwen-plus
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=

# WAHA pool. Fill both apiKey values to match WAHA_API_KEY_1/WAHA_API_KEY_2
# supplied to Docker Compose. dotenv does not interpolate JSON field values.
WAHA_POOL_SIZE=2
WAHA_INSTANCES=[{"id":"waha-1","baseURL":"http://localhost:3005","apiKey":"replace-with-instance-1-api-key"},{"id":"waha-2","baseURL":"http://localhost:3006","apiKey":"replace-with-instance-2-api-key"}]
# WHATSAPP_PROXY_SERVER=your-proxy-host:3128
# WHATSAPP_PROXY_SERVER_USERNAME=your-proxy-username
# WHATSAPP_PROXY_SERVER_PASSWORD=

# Legacy single-instance fallback; ignored when WAHA_INSTANCES is configured.
WAHA_API_URL=http://localhost:3004
WAHA_API_KEY=
WAHA_SESSION=default

# 32-byte UTF-8 encryption key for channel account configuration.
ENCRYPTION_KEY=

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Cloud gateway remains disabled until explicitly configured.
CLOUD_GATEWAY_ENABLED=false
CLOUD_GATEWAY_URL=ws://127.0.0.1:8787
# CLOUD_GATEWAY_AUTH_TOKEN=
# CLOUD_GATEWAY_AUTH_TOKEN_FILE=D:\secure\cloud-gateway-auth-token.txt
CLOUD_GATEWAY_CLIENT_ID=rag-server
CLOUD_GATEWAY_ACCOUNTS_JSON=[]
CLOUD_GATEWAY_HTTP_URL=http://127.0.0.1:8788
CLOUD_GATEWAY_TEST_TOOL_ENABLED=true
# CLOUD_GATEWAY_MOCK_TOKEN=
WECOM_PUBLIC_CALLBACK_BASE_URL=https://wecom.thelonelybrave.cn
# Local delivery defaults to one owner account. Team account management remains disabled.
AUTH_MODE=single_owner
AUTH_PUBLIC_REGISTRATION_ENABLED=false
# Windows 本地测试环境可由管理员在用户菜单中重启后端；生产环境默认关闭。
LOCAL_BACKEND_RESTART_ENABLED=true
