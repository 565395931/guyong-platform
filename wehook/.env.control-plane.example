CONTROL_PLANE_HOST=127.0.0.1
CONTROL_PLANE_PORT=8790
CONTROL_PLANE_STORE_PATH=./data/control-plane.json
CONTROL_PLANE_ADMIN_USERNAME=admin
# Initial password may contain 8+ characters; first sign-in forces a 12+ character replacement. Never commit the production value.
CONTROL_PLANE_ADMIN_PASSWORD=replace-with-a-strong-password
# Set false only for a deliberately fixed bootstrap account.
CONTROL_PLANE_ADMIN_MUST_CHANGE_PASSWORD=true
# At least 32 random characters. Rotating it invalidates browser sessions.
CONTROL_PLANE_SESSION_SECRET=replace-with-at-least-32-random-characters
# Dedicated 32-byte Base64 key for model API keys and WeCom installation secrets.
CONTROL_PLANE_DATA_KEY=replace-with-a-generated-32-byte-base64-key
# Shared only between the provider callback service and the control plane.
CONTROL_PLANE_INTERNAL_TOKEN=replace-with-a-long-random-token
WECOM_PROVIDER_SUITE_ID=replace-with-suite-id
WECOM_PROVIDER_SUITE_SECRET=replace-with-suite-secret
WECOM_INSTALL_REDIRECT_URI=https://provider.thelonelybrave.cn/wecom/install/complete
# 1 while testing an unpublished app; change to 0 before formal release.
WECOM_INSTALL_AUTH_TYPE=1
